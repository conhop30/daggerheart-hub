{
  "name": "daggerheart-hub-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "A local hub for creating Daggerheart homebrew content — Classes, Domains, Adversaries, Equipment, and more.",
  "author": "Connor Hopkins",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "concurrently -k -s first \"vite\" \"node scripts/electronDev.cjs\"",
    "electron:build": "npm run build && electron-builder --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "html-to-image": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.5",
    "electron": "^31.3.1",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.1.9",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.daggerheart.hub",
    "productName": "Daggerheart Homebrew Hub",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "seed/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "conhop30",
        "repo": "daggerheart-hub"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Daggerheart-Homebrew-Hub-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
